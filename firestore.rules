rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function activeUser() { return signedIn() && userDoc().data.accountStatus == 'active'; }
    function roleIs(role) { return activeUser() && userDoc().data.role == role; }
    function fixedOwner() { return signedIn() && request.auth.token.email_verified == true && request.auth.token.email == 'shadrat.almn7@gmail.com'; }
    function ownerOnly() { return fixedOwner() || roleIs('owner'); }
    function moderator() { return fixedOwner() || roleIs('owner') || roleIs('support') || roleIs('communityModerator'); }
    function safeText(value, minimum, maximum) { return value is string && value.size() >= minimum && value.size() <= maximum; }
    function validPostType(value) { return value in ['question','experience','info','guide','update','warning','accepted']; }

    match /users/{uid} {
      allow create: if own(uid) && request.resource.data.role == 'student'
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.publicProfile == false;
      allow read: if own(uid) || ownerOnly();
      allow update: if own(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName','username','location','studyLevel','publicProfile','avatarKey','updatedAt'
        ]);
      allow update: if ownerOnly();
      allow delete: if false;

      match /notifications/{notificationId} {
        allow read, update: if own(uid);
        allow create: if moderator();
        allow delete: if own(uid) || moderator();
      }
    }

    match /phoneReservations/{phoneHash} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && phoneHash.size() == 64;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || ownerOnly());
      allow update, delete: if false;
    }

    match /usernameReservations/{username} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && username.matches('^[a-z0-9_]{3,24}$')
        && !username.matches('.*(owner|admin|support|staff|shazarat).*');
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || ownerOnly());
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /scholarships/{slug} {
      allow read: if resource.data.publishStatus == 'published' || moderator();
      allow create: if ownerOnly()
        && request.resource.data.slug == slug
        && request.resource.data.publishStatus in ['draft','published','hidden','archived']
        && safeText(request.resource.data.title, 3, 160)
        && safeText(request.resource.data.shortDescription, 10, 500);
      allow update: if ownerOnly()
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.publishStatus in ['draft','published','hidden','archived']
        && safeText(request.resource.data.title, 3, 160)
        && safeText(request.resource.data.shortDescription, 10, 500);
      allow delete: if false;
    }

    match /services/{serviceId} {
      allow read: if resource.data.publishStatus == 'published' || moderator();
      allow create, update: if ownerOnly() && request.resource.data.publishStatus in ['draft','published','hidden','archived'] && safeText(request.resource.data.title,3,160);
      allow delete: if false;
    }

    match /offers/{offerId} {
      allow read: if resource.data.publishStatus == 'published' || moderator();
      allow create, update: if ownerOnly() && request.resource.data.publishStatus in ['draft','published','hidden','archived'] && safeText(request.resource.data.title,3,160);
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow create: if activeUser()
        && request.resource.data.userId == request.auth.uid
        && safeText(request.resource.data.name, 2, 120)
        && safeText(request.resource.data.email, 5, 200)
        && safeText(request.resource.data.message, 10, 5000)
        && request.resource.data.type in ['general','service','complaint','report','achievement']
        && request.resource.data.status == 'new';
      allow read: if ownerOnly() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if ownerOnly();
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow create: if activeUser()
        && request.resource.data.userId == request.auth.uid
        && safeText(request.resource.data.serviceTitle, 3, 200)
        && request.resource.data.status == 'created';
      allow read: if ownerOnly() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if ownerOnly();
      allow delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if resource.data.publishStatus == 'published' || ownerOnly();
      allow create, update: if ownerOnly()
        && safeText(request.resource.data.title, 3, 160)
        && safeText(request.resource.data.body, 3, 2000)
        && request.resource.data.publishStatus in ['draft','published','disabled','archived'];
      allow delete: if ownerOnly();
    }

    match /missions/{missionId} {
      allow read: if ownerOnly() || (activeUser() && resource.data.publishStatus == 'published'
        && (resource.data.targetType == 'all' || resource.data.targetUserId == request.auth.uid));
      allow create, update: if ownerOnly()
        && request.resource.data.publishStatus in ['draft','published','disabled','archived']
        && request.resource.data.targetType in ['all','user']
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.xp <= 2000
        && safeText(request.resource.data.title, 3, 160);
      allow delete: if false;
    }

    match /rewards/{rewardId} {
      allow read: if ownerOnly() || (activeUser() && resource.data.publishStatus == 'published'
        && (resource.data.targetType == 'all' || resource.data.targetUserId == request.auth.uid));
      allow create, update: if ownerOnly()
        && request.resource.data.publishStatus in ['draft','published','disabled','archived']
        && request.resource.data.targetType in ['all','user']
        && safeText(request.resource.data.title, 3, 160);
      allow delete: if false;
    }

    match /publicProfiles/{uid} {
      allow read: if resource.data.visible == true || own(uid) || moderator();
      allow create, update: if own(uid)
        && request.resource.data.keys().hasOnly(['uid','username','avatarKey','level','badges','expertise','verifiedExpert','verifiedAccepted','visible','updatedAt'])
        && request.resource.data.uid == uid;
      allow delete: if own(uid) || moderator();
    }

    match /communityPosts/{postId} {
      allow read: if resource.data.status == 'published' || moderator()
        || (signedIn() && resource.data.authorId == request.auth.uid);
      allow create: if activeUser()
        && request.resource.data.authorId == request.auth.uid
        && safeText(request.resource.data.body, 10, 5000)
        && validPostType(request.resource.data.type)
        && request.resource.data.status in ['published','pendingReview']
        && request.resource.data.imageCount == 0
        && request.resource.data.deletedAt == null;
      allow update: if activeUser() && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.status == resource.data.status
        && request.resource.data.helpfulCount == resource.data.helpfulCount
        && request.resource.data.commentCount == resource.data.commentCount
        && request.resource.data.saveCount == resource.data.saveCount
        && safeText(request.resource.data.body, 10, 5000)
        && validPostType(request.resource.data.type);
      allow update: if moderator();
      allow delete: if false;

      match /comments/{commentId} {
        allow read: if get(/databases/$(database)/documents/communityPosts/$(postId)).data.status == 'published' || moderator();
        allow create: if activeUser() && request.resource.data.authorId == request.auth.uid
          && safeText(request.resource.data.body, 2, 2000)
          && request.resource.data.status == 'published'
          && (request.resource.data.parentId == null
            || (request.resource.data.parentId is string
              && get(/databases/$(database)/documents/communityPosts/$(postId)/comments/$(request.resource.data.parentId)).data.parentId == null))
          && request.resource.data.deletedAt == null;
        allow update: if activeUser() && resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.helpfulCount == resource.data.helpfulCount
          && request.resource.data.status == resource.data.status
          && safeText(request.resource.data.body, 2, 2000);
        allow update: if moderator();
        allow delete: if false;

        match /helpful/{uid} {
          allow read: if signedIn();
          allow create: if own(uid)
            && get(/databases/$(database)/documents/communityPosts/$(postId)/comments/$(commentId)).data.authorId != request.auth.uid;
          allow delete: if own(uid);
          allow update: if false;
        }
      }

      match /helpful/{uid} {
        allow read: if signedIn();
        allow create: if own(uid)
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.authorId != request.auth.uid;
        allow delete: if own(uid);
        allow update: if false;
      }
    }

    match /savedCommunityPosts/{saveId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /communityReports/{reportId} {
      allow create: if activeUser() && request.resource.data.reporterId == request.auth.uid
        && safeText(request.resource.data.reason, 5, 500)
        && request.resource.data.status == 'open';
      allow read, update: if moderator();
      allow delete: if false;
    }

    match /expertApplications/{applicationId} {
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if ownerOnly() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if ownerOnly();
      allow delete: if false;
    }

    match /moderationActions/{actionId} {
      allow read, create: if moderator();
      allow update, delete: if false;
    }

    match /xpTransactions/{transactionId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || ownerOnly());
      allow create: if ownerOnly()
        && request.resource.data.points is int
        && request.resource.data.userId is string
        && safeText(request.resource.data.reason, 3, 300);
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
